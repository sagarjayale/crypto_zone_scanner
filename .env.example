# Copy to .env and fill in. Never commit .env or paste these values anywhere.
# Binance market data is public: no API key is needed, and the app never places an order.

# MySQL. The database is created on first start if it does not exist.
# Write the password exactly as it is; characters like @ need no escaping here.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=crypto_scanner_db

# Leave the DB_ values empty to use a local SQLite file (crypto_scanner.db) instead.
# DATABASE_URL, if set, overrides everything above.

# 1 runs the schedule and the live price feed inside the app; 0 switches both off.
SCHEDULER_ENABLED=1

# Scans run in this many separate worker processes on MySQL (several coins at once, on several CPU cores).
# Leave it empty for the number of CPU cores less one (at least 1, at most 4). 0 scans inside the app's own process.
SCAN_WORKERS=

# Optional. Only change these if Binance moves its addresses.
# BINANCE_REST=https://fapi.binance.com
# BINANCE_WS=wss://fstream.binance.com

# Optional. Can also be entered on the Settings page.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
